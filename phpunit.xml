<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="TRUSTED_PROXIES" value=""/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SCOUT_DRIVER" value="collection"/>
        <env name="SCOUT_QUEUE" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Documented AI defaults, so a developer's local .env never changes test results. -->
        <env name="NEWS_AI_PROVIDER" value="gemini"/>
        <env name="NEWS_AI_MODEL" value=""/>
        <env name="NEWS_FETCH_TIME" value="03:00"/>
        <env name="SCHEDULE_TIMEZONE" value="Europe/Madrid"/>
        <env name="DEBATE_STT_PROVIDER" value="openai"/>
        <env name="DEBATE_STT_MODEL" value="whisper-1"/>
        <env name="DEBATE_LLM_PROVIDER" value="gemini"/>
        <env name="DEBATE_LLM_MODEL" value=""/>
        <env name="DEBATE_LLM_OPTIONS" value=""/>
        <env name="DEBATE_EVAL_PROVIDER" value=""/>
        <env name="DEBATE_EVAL_MODEL" value=""/>
        <env name="DEBATE_TTS_PROVIDER" value="openai"/>
        <env name="DEBATE_TTS_MODEL" value=""/>
        <env name="DEBATE_TTS_VOICE" value="alloy"/>
        <env name="DEBATE_TTS_FALLBACK_MODEL" value=""/>
        <env name="LOOKUP_AI_PROVIDER" value="gemini"/>
        <env name="LOOKUP_AI_MODEL" value=""/>
        <env name="LOOKUP_TARGET_LANGUAGE" value="Spanish"/>
        <!-- The rest of the documented defaults, for the same reason. -->
        <env name="REVERB_ALLOWED_ORIGINS" value="*"/>
        <env name="NEWS_ALLOW_PRIVATE_HOSTS" value="false"/>
        <env name="REDIS_QUEUE_RETRY_AFTER" value="180"/>
        <env name="DB_QUEUE_RETRY_AFTER" value="180"/>
        <env name="DEBATE_QUEUE" value="debates"/>
        <env name="DEBATE_AUDIO_DISK" value="local"/>
        <env name="DEBATE_AUDIO_RETENTION_DAYS" value="7"/>
        <env name="DEBATE_DAILY_TURNS" value="300"/>
        <env name="DEBATE_STT_TIMEOUT" value="30"/>
        <env name="DEBATE_LLM_TIMEOUT" value="30"/>
        <env name="DEBATE_TTS_TIMEOUT" value="30"/>
        <env name="DEBATE_TTS_FALLBACK_TIMEOUT" value="20"/>
        <env name="DEBATE_EVAL_TIMEOUT" value="60"/>
        <env name="DEBATE_TTS_FALLBACK_PROVIDER" value=""/>
        <env name="DEBATE_TTS_FALLBACK_VOICE" value="alloy"/>
        <env name="LOOKUP_AI_TIMEOUT" value="20"/>
        <env name="NEWS_AI_TIMEOUT" value="60"/>
        <env name="NEWS_MAX_ARTICLES_PER_FEED" value="5"/>
        <env name="NEWS_QUEUE_RETRY_AFTER" value="1800"/>
    </php>
</phpunit>
