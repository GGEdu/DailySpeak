APP_NAME=DailySpeak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dailyspeak
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must be longer than the slowest job (ProcessVoiceDebate allows 120s).
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dailyspeak.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_NO_ANALYTICS=false
MEILISEARCH_UPGRADE_DB=true

GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_MAX_ARTICLES_PER_FEED=5
NEWS_AI_PROVIDER=gemini
# Leave empty to use the provider's default text model, or pin one (e.g. gpt-4o-mini).
NEWS_AI_MODEL=

# Voice debate: speech-to-text, tutor LLM and text-to-speech (see config/debate.php).
DEBATE_STT_PROVIDER=openai
DEBATE_STT_MODEL=whisper-1
DEBATE_LLM_PROVIDER=gemini
DEBATE_LLM_MODEL=
DEBATE_TTS_PROVIDER=openai
DEBATE_TTS_MODEL=
DEBATE_TTS_VOICE=alloy

# Local development credentials for the Sail "reverb" service.
REVERB_APP_ID=dailyspeak
REVERB_APP_KEY=dailyspeak-local-key
REVERB_APP_SECRET=dailyspeak-local-secret
# Where the app publishes events (the Reverb container inside the Sail network)...
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
# ...and where the browser connects to it.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
